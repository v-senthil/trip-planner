# === TripPlanner Environment Variables ===

# Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Weather API (OpenWeatherMap - https://openweathermap.org/api - free tier)
OPENWEATHER_API_KEY=17fec26cc055bb083206462116a1ef4d

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# === Open Source Maps (NO API keys needed!) ===
# Nominatim (geocoding): https://nominatim.openstreetmap.org - free
# OSRM (routing): https://router.project-osrm.org - free
# Overpass API (POI data): https://overpass-api.de - free
# OpenStreetMap tiles: https://tile.openstreetmap.org - free
